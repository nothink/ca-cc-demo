{
  "name": "ca-cc-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Architecture × Claude Code demo (Todo/User with role-based permission)",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/infrastructure/drizzle/seed.ts",
    "drizzle:generate": "drizzle-kit generate",
    "erd": "liam erd build --format drizzle --input \"src/infrastructure/drizzle/schema/*.ts\" && rm -rf docs/erd && mv dist docs/erd",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:svg": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/dependency-graph.svg"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.1.0",
    "@scalar/hono-api-reference": "^0.9.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.9.0",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@liam-hq/cli": "^0.7.24",
    "@types/node": "^24.5.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^17.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
